# Control Plane
CONTROL_PLANE_URL=https://open-inspect-control-plane.YOUR-ACCOUNT.workers.dev
NEXT_PUBLIC_WS_URL=wss://open-inspect-control-plane.YOUR-ACCOUNT.workers.dev
# Set to http for a self-hosted Node web server. Cloudflare Workers deployments
# should leave this unset so they can use the CONTROL_PLANE_WORKER binding.
CONTROL_PLANE_TRANSPORT=

# Control Plane Authentication: web's per-service sig1 signing secret. Must
# match the control plane's SERVICE_AUTH_SECRET_WEB binding (Terraform
# generates it — read it from terraform state or the deployed web app's env;
# do not generate your own against an existing backend).
SERVICE_AUTH_SECRET=
